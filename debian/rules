#!/usr/bin/make -f

VERSION=1.12

%:
	dh $@

build-orig:
	mkdir -p libec-$(VERSION)
	tar --exclude=debian --exclude=\*~ --exclude=.svn --exclude=\*.o \
		--exclude=libec-$(VERSION) -cf - . \
		| ( cd libec-$(VERSION) && tar xf - )
	tar -czf ../tarballs/libec_$(VERSION).orig.tar.gz libec-$(VERSION)
	$(RM) -r libec-$(VERSION)
