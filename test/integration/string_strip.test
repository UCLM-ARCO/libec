# -*- mode: python; coding: utf-8 -*-

binary = "string_strip"
make = Test('make {0}'.format(binary), cwd="$testdir")
make.gen += "$testdir/{0}".format(binary)


strings = [
    '',
    ' hello  ',
    'hello world   ',
    ]

for i in strings:
    t = Test('$testdir/{0} "{1}"'.format(binary, i), shell=True)
    t.post += FileContains("[{0}]".format(i.strip()))

