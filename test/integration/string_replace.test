# -*- mode: python; coding: utf-8 -*-

binary = "string_replace"
make = Test('make {0}'.format(binary), cwd="$testdir")
make.gen += "$testdir/{0}".format(binary)


replaces = [
    ('fabadafabada', 'a', '0', 'f0b0d0f0b0d0'),
    ('1234567890', '2345', '_', '1_67890')
    ]

for i in replaces:
    t = Test('$testdir/{0} {1} {2} {3}'.format(binary, *tuple(i[0:3])))
    t.post += FileContains([i[0], i[3]])

