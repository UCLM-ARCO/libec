# -*- mode: python; coding: utf-8 -*-

import os


binary = "os_path_join"
make = Test('make {0}'.format(binary), cwd="$testdir")
make.gen += "$testdir/{0}".format(binary)


paths = [
    'usr/share slice/ /other/ sample.ice',
    ]

for i in paths:
    t = Test('$testdir/{0} {1}'.format(binary, i))
    t.post += FileContains(os.path.join(i.split()))

